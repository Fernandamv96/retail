# Variables para producción (Vercel). Copia este archivo a .env (no se sube a git) solo
# si necesitas correr comandos contra la base de Neon desde tu computador.

# Obligatorias en Vercel
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Opcionales
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app

# Correo del formulario de contacto (si no se define, los mensajes quedan solo en /admin/)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CORREO_CONTACTO=
